#!/bin/bash
set -uo pipefail
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME:-mihomo-core}}"

# 卸载时彻底清理残留进程 (避免端口被占用)
pkill -9 -f "mihomo" 2>/dev/null || true
pkill -9 -f "status_server.py" 2>/dev/null || true
pkill -9 -f "mihomo-core" 2>/dev/null || true
command -v fuser >/dev/null 2>&1 && { fuser -k 9090/tcp 7890/tcp 9092/tcp 2>/dev/null || true; }

echo "[$(date '+%F %T')] mihomo-core uninstalled (cleanup done)" >> "${DATA_DIR}/install.log" 2>/dev/null
rm -f "${DATA_DIR}/mihomo.pid" "${DATA_DIR}/status.pid"
exit 0
