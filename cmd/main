#!/bin/bash
# mihomo-core — 只运行 mihomo 内核（自启服务），用 MetaCubeXD 面板控制
# v1.1.0 — 修复 status page 启动遗漏 / set -e 导致提前退出 / PID 文件可靠性
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-mihomo-core}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME}}"
MIHOMO_BIN="${APP_DIR}/mihomo"
STATUS_BIN="${APP_DIR}/status_server.py"
# 兼容 fnOS 各种 TRIM_APPDEST：实际文件可能在 APP_DIR 或其 target 子目录
if [ ! -f "${MIHOMO_BIN}" ] && [ -f "${APP_DIR}/target/mihomo" ]; then
    MIHOMO_BIN="${APP_DIR}/target/mihomo"
fi
if [ ! -f "${STATUS_BIN}" ] && [ -f "${APP_DIR}/target/status_server.py" ]; then
    STATUS_BIN="${APP_DIR}/target/status_server.py"
fi
STATUS_PORT="${MIHOMO_STATUS_PORT:-9092}"
APP_VERSION="${MIHOMO_APP_VERSION:-1.1.0}"
LOG="${DATA_DIR}/mihomo.log"
PID_FILE="${DATA_DIR}/mihomo.pid"
STATUS_PID_FILE="${DATA_DIR}/status.pid"
# 运行时配置（首次启动从安装目录复制，之后用户可在面板改）
CORE_CONFIG="${DATA_DIR}/config.yaml"

mkdir -p "${DATA_DIR}"

log() { echo "[$(date '+%F %T')] $*" >> "${LOG}"; }

# ── 检查端口是否被占用（非本脚本启动的进程） ─────────────
port_occupied() {
    local port="$1"
    # 用 /proc 判断占用端口的进程是否是 mihomo 或 status_server
    local pid
    pid=$(lsof -ti :"${port}" 2>/dev/null || true)
    if [ -z "${pid}" ]; then
        return 1  # 端口空闲
    fi
    # 端口被占用，检查是否是我们的进程
    local cmd
    cmd=$(ps -p "${pid}" -o args= 2>/dev/null || true)
    if echo "${cmd}" | grep -qE 'mihomo|status_server'; then
        return 0  # 是我们的进程占用
    fi
    return 2  # 被其他进程占用
}

ensure_config() {
    # 首次启动: 把默认 config.yaml 复制到数据目录
    if [ ! -f "${CORE_CONFIG}" ]; then
        if [ -f "${APP_DIR}/config.yaml" ]; then
            cp "${APP_DIR}/config.yaml" "${CORE_CONFIG}"
            echo "initialized config.yaml" >> "${LOG}"
        fi
    fi
    # 应用设置配置的订阅链接: 写入 config.yaml 的 proxy-providers
    if [ -f "${DATA_DIR}/subscription_url" ]; then
        SUB_URL="$(cat "${DATA_DIR}/subscription_url")"
        apply_subscription "${SUB_URL}"
    fi
    # 预置 geoip 数据 (避免 mihomo 走公网下载失败)
    if [ -f "${APP_DIR}/geoip.metadb" ]; then
        cp -f "${APP_DIR}/geoip.metadb" "${DATA_DIR}/geoip.metadb"
        echo "preseed geoip.metadb" >> "${LOG}"
    fi
    # 预置 geosite (可选)
    if [ ! -f "${DATA_DIR}/geosite.dat" ] && [ -f "${APP_DIR}/geosite.dat" ]; then
        cp "${APP_DIR}/geosite.dat" "${DATA_DIR}/geosite.dat"
        echo "preseed geosite.dat" >> "${LOG}"
    fi
}

# 拉取订阅作为完整 config.yaml（节点+规则+分组全生效），并强制本应用端口
apply_subscription() {
    local subdata="$1"
    if [ -z "${subdata}" ]; then
        return 0
    fi
    local url
    if [[ "${subdata}" == *"|"* ]]; then
        url="${subdata#*|}"
    else
        url="${subdata}"
    fi
    url="$(echo "${url}" | tr -d '[:space:]')"
    echo "[$(date '+%F %T')] apply_subscription: pulling ${url}" >> "${LOG}"
    python3 - "${url}" "${CORE_CONFIG}" <<'PYEOF'
import sys, re, urllib.request
url, p = sys.argv[1], sys.argv[2]
try:
    req = urllib.request.Request(url, headers={"User-Agent": "clash.meta", "Accept": "application/yaml"})
    with urllib.request.urlopen(req, timeout=40) as r:
        data = r.read().decode('utf-8', errors='replace')
    if not data.strip():
        print("EMPTY"); sys.exit(1)
    data = re.sub(r'(?m)^mixed-port:.*$', 'mixed-port: 7890', data)
    data = re.sub(r'(?m)^port:.*$', 'port: 7890', data)
    data = re.sub(r'(?m)^socks-port:.*$', 'socks-port: 7890', data)
    data = re.sub(r'(?m)^external-controller:.*$', "external-controller: '0.0.0.0:9090'", data)
    open(p, 'w', encoding='utf-8').write(data)
    print("OK", len(data))
except Exception as e:
    print("ERR", e); sys.exit(1)
PYEOF
}

# ── 启动 mihomo 内核 ─────────────────────────────────────
start() {
    local core_running=no

    # 1. 检查 PID 文件指向的进程是否存活
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        core_running=yes
        log "already running (pid $(cat "${PID_FILE}"))"
    fi

    # 2. 检查 Clash API 端口（覆盖 PID 文件丢失 / 旧进程残留的情况）
    if [ "${core_running}" = "no" ] && curl -sf "http://127.0.0.1:9090/version" >/dev/null 2>&1; then
        core_running=yes
        log "port 9090 already serving — treating as running"
    fi

    # 3. 核心未运行 → 启动
    if [ "${core_running}" = "no" ]; then
        ensure_config
        nohup "${MIHOMO_BIN}" -d "${DATA_DIR}" -f "${CORE_CONFIG}" >> "${LOG}" 2>&1 &
        echo $! > "${PID_FILE}"
        log "mihomo started (pid $(cat "${PID_FILE}"))"

        # 等待内核就绪（最多 20s）
        local ready=no
        for i in $(seq 1 20); do
            if curl -sf "http://127.0.0.1:9090/version" >/dev/null 2>&1; then
                log "core ready on :9090 after ${i}s"
                ready=yes
                break
            fi
            sleep 1
        done
        if [ "${ready}" = "no" ]; then
            log "core start timed out"
        fi
    fi

    # 4. 无论核心是否已运行，都确保状态页启动（修复 status_page=no）
    start_status
}

# ── 停止 ─────────────────────────────────────────────────
stop() {
    if [ -f "${PID_FILE}" ]; then
        local PID
        PID=$(cat "${PID_FILE}")
        kill "${PID}" 2>/dev/null || true
        for i in 1 2 3; do
            if ! kill -0 "${PID}" 2>/dev/null; then
                rm -f "${PID_FILE}"
                log "stopped (pid ${PID})"
                break
            fi
            sleep 1
        done
        kill -9 "${PID}" 2>/dev/null || true
        rm -f "${PID_FILE}"
    fi
    stop_status
    # 彻底清理: 杀掉一切残留
    pkill -9 -f "${MIHOMO_BIN}" 2>/dev/null || true
    pkill -9 -f "status_server.py" 2>/dev/null || true
    # 释放端口
    command -v fuser >/dev/null 2>&1 && { fuser -k 9090/tcp 7890/tcp ${STATUS_PORT}/tcp 2>/dev/null || true; }
    log "stop complete"
}

# ── 状态页服务 (:9092) ─────────────────────────────
start_status() {
    # 检查状态页是否已在运行
    if [ -f "${STATUS_PID_FILE}" ] && kill -0 "$(cat "${STATUS_PID_FILE}")" 2>/dev/null; then
        return 0
    fi
    # 检查端口是否被占用（可能是旧进程残留）
    if port_occupied "${STATUS_PORT}"; then
        log "status page port ${STATUS_PORT} occupied by existing process, skipping start"
        return 0
    fi
    MIHOMO_APP_VERSION="${APP_VERSION}" MIHOMO_STATUS_PORT="${STATUS_PORT}" MIHOMO_DATA_DIR="${DATA_DIR}" \
        nohup /usr/bin/python3 "${STATUS_BIN}" >> "${LOG}" 2>&1 &
    echo $! > "${STATUS_PID_FILE}"
    log "status page started on :${STATUS_PORT} (pid $!)"
}

stop_status() {
    if [ -f "${STATUS_PID_FILE}" ]; then
        kill "$(cat "${STATUS_PID_FILE}")" 2>/dev/null || true
        rm -f "${STATUS_PID_FILE}"
    fi
    pkill -f "status_server.py" 2>/dev/null || true
}

status() {
    local core_ok=no web_ok=no
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        core_ok=yes
    elif curl -sf "http://127.0.0.1:9090/version" >/dev/null 2>&1; then
        core_ok=yes
    fi
    if [ -f "${STATUS_PID_FILE}" ] && kill -0 "$(cat "${STATUS_PID_FILE}")" 2>/dev/null; then
        web_ok=yes
    elif curl -sf "http://127.0.0.1:${STATUS_PORT}/" >/dev/null 2>&1; then
        web_ok=yes
    fi
    echo "core=${core_ok} status_page=${web_ok}"
    [ "${core_ok}" = "yes" ]
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
