#!/bin/bash
# mihomo-core — 只运行 mihomo 内核（自启服务），用 MetaCubeXD 面板控制
# v1.1.1 — 加固生命周期脚本，增加错误日志
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-mihomo-core}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME}}"
MIHOMO_BIN="${APP_DIR}/mihomo"
STATUS_BIN="${APP_DIR}/status_server.py"
# 兼容 fnOS 各种 TRIM_APPDEST：实际文件可能在 APP_DIR 或其 target 子目录
if [ ! -f "${MIHOMO_BIN}" ] && [ -f "${APP_DIR}/target/mihomo" ]; then
    MIHOMO_BIN="${APP_DIR}/target/mihomo"
fi
if [ ! -f "${STATUS_BIN}" ] && [ -f "${APP_DIR}/target/status_server.py" ]; then
    STATUS_BIN="${APP_DIR}/target/status_server.py"
fi
STATUS_PORT="${MIHOMO_STATUS_PORT:-9092}"
APP_VERSION="${MIHOMO_APP_VERSION:-1.1.1}"
LOG="${DATA_DIR}/mihomo.log"
PID_FILE="${DATA_DIR}/mihomo.pid"
STATUS_PID_FILE="${DATA_DIR}/status.pid"
CORE_CONFIG="${DATA_DIR}/config.yaml"

mkdir -p "${DATA_DIR}" 2>/dev/null || true

log() { echo "[$(date '+%F %T')] $*" >> "${LOG}" 2>/dev/null || true; }
elog() { echo "[$(date '+%F %T')] ERROR: $*" >> "${LOG}" 2>/dev/null; echo "ERROR: $*" >&2; }

# ── 检查端口是否被占用（非本脚本启动的进程） ─────────────
port_occupied() {
    local port="$1" pid=""
    pid=$(lsof -ti :"${port}" 2>/dev/null) || true
    if [ -z "${pid}" ]; then
        return 1
    fi
    local cmd=""
    cmd=$(ps -p "${pid}" -o args= 2>/dev/null) || true
    if [ -n "${cmd}" ] && echo "${cmd}" | grep -qE 'mihomo|status_server'; then
        return 0
    fi
    return 2
}

ensure_config() {
    if [ ! -f "${CORE_CONFIG}" ]; then
        if [ -f "${APP_DIR}/config.yaml" ]; then
            cp "${APP_DIR}/config.yaml" "${CORE_CONFIG}" 2>/dev/null
            log "initialized config.yaml"
        fi
    fi
    if [ -f "${DATA_DIR}/subscription_url" ]; then
        local subdata=""
        subdata=$(cat "${DATA_DIR}/subscription_url" 2>/dev/null) || true
        if [ -n "${subdata}" ]; then
            apply_subscription "${subdata}"
        fi
    fi
    if [ -f "${APP_DIR}/geoip.metadb" ]; then
        cp -f "${APP_DIR}/geoip.metadb" "${DATA_DIR}/geoip.metadb" 2>/dev/null || true
        log "preseed geoip.metadb"
    fi
    if [ ! -f "${DATA_DIR}/geosite.dat" ] && [ -f "${APP_DIR}/geosite.dat" ]; then
        cp "${APP_DIR}/geosite.dat" "${DATA_DIR}/geosite.dat" 2>/dev/null || true
        log "preseed geosite.dat"
    fi
}

apply_subscription() {
    local subdata="$1"
    if [ -z "${subdata}" ]; then
        return 0
    fi
    local url=""
    if [[ "${subdata}" == *"|"* ]]; then
        url="${subdata#*|}"
    else
        url="${subdata}"
    fi
    url="$(echo "${url}" | tr -d '[:space:]')"
    if [ -z "${url}" ]; then
        return 0
    fi
    log "apply_subscription: pulling ${url}"
    python3 - "${url}" "${CORE_CONFIG}" <<'PYEOF' 2>/dev/null
import sys, re, urllib.request
url, p = sys.argv[1], sys.argv[2]
try:
    req = urllib.request.Request(url, headers={"User-Agent": "clash.meta", "Accept": "application/yaml"})
    with urllib.request.urlopen(req, timeout=40) as r:
        data = r.read().decode('utf-8', errors='replace')
    if not data.strip():
        print("EMPTY"); sys.exit(1)
    data = re.sub(r'(?m)^mixed-port:.*$', 'mixed-port: 7890', data)
    data = re.sub(r'(?m)^port:.*$', 'port: 7890', data)
    data = re.sub(r'(?m)^socks-port:.*$', 'socks-port: 7890', data)
    data = re.sub(r'(?m)^external-controller:.*$', "external-controller: '0.0.0.0:9090'", data)
    open(p, 'w', encoding='utf-8').write(data)
    print("OK", len(data))
except Exception as e:
    print("ERR", e); sys.exit(1)
PYEOF
    return 0
}

# ── 启动 mihomo 内核 ─────────────────────────────────────
start() {
    local core_running=no

    if [ -f "${PID_FILE}" ]; then
        local old_pid=""
        old_pid=$(cat "${PID_FILE}" 2>/dev/null) || true
        if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null; then
            core_running=yes
            log "already running (pid ${old_pid})"
        else
            rm -f "${PID_FILE}" 2>/dev/null || true
        fi
    fi

    if [ "${core_running}" = "no" ] && curl -sf "http://127.0.0.1:9090/version" >/dev/null 2>&1; then
        core_running=yes
        log "port 9090 already serving — treating as running"
    fi

    if [ "${core_running}" = "no" ]; then
        ensure_config || true
        nohup "${MIHOMO_BIN}" -d "${DATA_DIR}" -f "${CORE_CONFIG}" >> "${LOG}" 2>&1 &
        echo $! > "${PID_FILE}"
        log "mihomo started (pid $(cat "${PID_FILE}" 2>/dev/null))"

        local ready=no i=""
        for i in $(seq 1 20); do
            if curl -sf "http://127.0.0.1:9090/version" >/dev/null 2>&1; then
                log "core ready on :9090 after ${i}s"
                ready=yes
                break
            fi
            sleep 1
        done
        if [ "${ready}" = "no" ]; then
            log "core start timed out"
        fi
    fi

    start_status
}

# ── 停止 ─────────────────────────────────────────────────
stop() {
    log "stop: begin"
    local pid=""

    # 1. 读取 PID 文件
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" 2>/dev/null) || true
    fi

    # 2. 优雅停止
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        log "stop: killing pid ${pid}"
        kill "${pid}" 2>/dev/null || true
        local i=""
        for i in 1 2 3; do
            kill -0 "${pid}" 2>/dev/null || break
            sleep 1
        done
        # 强杀
        kill -9 "${pid}" 2>/dev/null || true
        log "stop: stopped pid ${pid}"
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true

    # 3. 停止状态页
    stop_status

    # 4. 彻底清理残留（pkill 匹配进程名，不会杀本脚本）
    pkill -9 -f "${APP_DIR}/mihomo" 2>/dev/null || true
    pkill -9 -f "status_server" 2>/dev/null || true

    # 5. 释放端口
    fuser -k 9090/tcp 7890/tcp ${STATUS_PORT}/tcp 2>/dev/null || true

    log "stop: complete"
    return 0
}

# ── 状态页服务 (:9092) ─────────────────────────────
start_status() {
    if [ -f "${STATUS_PID_FILE}" ] && kill -0 "$(cat "${STATUS_PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        return 0
    fi
    if port_occupied "${STATUS_PORT}"; then
        log "status page port ${STATUS_PORT} occupied, skipping start"
        return 0
    fi
    MIHOMO_APP_VERSION="${APP_VERSION}" MIHOMO_STATUS_PORT="${STATUS_PORT}" MIHOMO_DATA_DIR="${DATA_DIR}" \
        nohup /usr/bin/python3 "${STATUS_BIN}" >> "${LOG}" 2>&1 &
    echo $! > "${STATUS_PID_FILE}"
    log "status page started on :${STATUS_PORT} (pid $!)"
}

stop_status() {
    local spid=""
    if [ -f "${STATUS_PID_FILE}" ]; then
        spid=$(cat "${STATUS_PID_FILE}" 2>/dev/null) || true
    fi
    if [ -n "${spid}" ] && kill -0 "${spid}" 2>/dev/null; then
        kill "${spid}" 2>/dev/null || true
    fi
    rm -f "${STATUS_PID_FILE}" 2>/dev/null || true
}

status() {
    local core_ok=no web_ok=no
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        core_ok=yes
    elif curl -sf "http://127.0.0.1:9090/version" >/dev/null 2>&1; then
        core_ok=yes
    fi
    if [ -f "${STATUS_PID_FILE}" ] && kill -0 "$(cat "${STATUS_PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        web_ok=yes
    elif curl -sf "http://127.0.0.1:${STATUS_PORT}/" >/dev/null 2>&1; then
        web_ok=yes
    fi
    echo "core=${core_ok} status_page=${web_ok}"
    [ "${core_ok}" = "yes" ]
}

case "${1:-start}" in
    start) start ;;
    stop)  stop  ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
